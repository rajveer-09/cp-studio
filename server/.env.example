# Copy this file to server/.env and fill it in. server/.env is git-ignored and excluded from Docker builds.

# Gemini API keys (https://aistudio.google.com/apikey), comma-separated. Leave empty to turn the AI assistant off.
# Requests rotate through the keys; a key that runs out of quota rests until it refills and the others take over.
# Gemini counts quota per Google Cloud project, so create each key in its own project ("Create API key in new project").
GEMINI_API_KEYS=

# Main model. gemini-3.6-flash is fast (~5 s replies); gemini-3.8-flash is newer but was often overloaded when tested.
GEMINI_MODEL=gemini-3.6-flash

# Used in order once every key is out of quota on the main model (the Flash-Lite models have much higher free limits).
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional shared password. When set, people must enter it once in the browser before they can run code or use the AI.
# Strongly recommended for any deployment reachable from the internet.
ACCESS_KEY=

# Port the server listens on. In production it also serves the built client.
PORT=3001

# Set when running behind a reverse proxy / platform load balancer (Render, Railway, Fly.io, nginx…)
# so rate limiting sees each user's real IP.
# TRUST_PROXY=1

# Override compiler/interpreter commands if they are not on PATH.
# CXX=g++
# JAVAC=javac
# JAVA=java
# PYTHON=python3
# GDB=gdb

# How many programs may compile/run at the same time (default: number of CPU cores, at least 2).
# MAX_CONCURRENT_RUNS=4
