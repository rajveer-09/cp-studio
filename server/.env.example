# Copy this file to server/.env and fill it in. server/.env is git-ignored and excluded from Docker builds.

# Gemini API key (https://aistudio.google.com/apikey). Leave empty to turn the AI assistant off.
GEMINI_API_KEY=

# Model used by the assistant. gemini-3.6-flash is fast (~5 s replies); gemini-3.8-flash is newer but was often overloaded when tested.
GEMINI_MODEL=gemini-3.6-flash

# Optional shared password. When set, people must enter it once in the browser before they can run code or use the AI.
# Strongly recommended for any deployment reachable from the internet.
ACCESS_KEY=

# Port the server listens on. In production it also serves the built client.
PORT=3001

# Set when running behind a reverse proxy / platform load balancer (Render, Railway, Fly.io, nginx…)
# so rate limiting sees each user's real IP.
# TRUST_PROXY=1

# Override compiler/interpreter commands if they are not on PATH.
# CXX=g++
# JAVAC=javac
# JAVA=java
# PYTHON=python3
# GDB=gdb

# How many programs may compile/run at the same time (default: number of CPU cores, at least 2).
# MAX_CONCURRENT_RUNS=4
